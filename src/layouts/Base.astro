---
import '@fontsource-variable/jetbrains-mono';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/font-pixel.css';
import '@/styles/ui.css';
import '@/styles/prose.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import PixelIcon from '@/components/PixelIcon.astro';
import { site } from '@/config';

/** 全站静态星空：确定性种子生成，暗/亮双主题各自成立 */
function mulberry32(a: number) {
  return function () {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20261028);
type StarKind = 'dim' | 'mid' | 'bright' | 'accent' | 'amber';
const stars: { x: number; y: number; kind: StarKind }[] = [];
// 对角密度梯度：右上密、左下疏（下限 0.42 保证下半区不成真空）；
// 星徽区（右上）与标题区（左上正文带）避让，让构图元素独立成层
for (let i = 0; i < 500 && stars.length < 150; i++) {
  const x = Math.round(rand() * 1000) / 10;
  const y = Math.round(rand() * 1000) / 10;
  const r = rand();
  const kind: StarKind = r < 0.6 ? 'dim' : r < 0.85 ? 'mid' : r < 0.945 ? 'bright' : r < 0.985 ? 'accent' : 'amber';
  const density = 0.42 + 0.58 * ((x / 100 + (100 - y) / 100) / 2);
  if (rand() > density) continue;
  if (x > 60 && y < 55 && rand() > 0.22) continue; // 星徽区避让
  if (x > 5 && x < 48 && y > 16 && y < 32 && kind !== 'dim') continue; // 标题/正文带只留暗星
  stars.push({ x, y, kind });
}

const UP = [
  '...KK...',
  '..KKKK..',
  '.KKKKKK.',
  'KKKKKKKK',
  '...KK...',
  '...KK...',
  '...KK...',
  '...KK...',
];

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === site.name ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={new URL('/rss.xml', site.url).href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f3f9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#191c2c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // 首帧前设定主题，避免闪烁；js 类供入场揭示的可见性规则使用
      (function () {
        document.documentElement.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        var d = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = d ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <div class="starfield" aria-hidden="true">
      {stars.map((s) => <i class:list={['star', `star--${s.kind}`]} style={`left:${s.x}%;top:${s.y}%`} />)}
    </div>
    <a class="skip" href="#main">跳到正文</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <a class="icon-btn scroll-top" href="#main" aria-label="回到顶部">
      <PixelIcon m={UP} size={16} />
    </a>
    <script>
      const topBtn = document.querySelector<HTMLAnchorElement>('.scroll-top');
      if (topBtn) {
        const sync = () => topBtn.classList.toggle('show', window.scrollY > 600);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
        topBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style>
  .starfield { position: fixed; inset: 0; z-index: -1; overflow: hidden; }
  .star { position: absolute; width: 2px; height: 2px; background: var(--color-star-dim); opacity: 0.45; }
  .star--mid { background: var(--color-star-mid); opacity: 0.6; }
  .star--bright { width: 3px; height: 3px; background: var(--color-star-bright); opacity: 0.85; }
  .star--accent { background: var(--color-accent); opacity: 0.8; }
  .star--amber { background: var(--color-star-amber); opacity: 0.85; }
</style>
