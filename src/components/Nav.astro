---
import { nav } from '@/config';
import HMark from './HMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import { site } from '@/config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---
<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label={`${site.name}，返回首页`}>
      <HMark size={26} />
      <span class="px brand-name">{site.name}</span>
    </a>
    <nav class="nav-links" aria-label="主导航">
      {nav.map((item) => (
        <a class="px nav-link" href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <Search />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-paper);
    border-bottom: var(--border-pixel) solid var(--color-rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--color-ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand-name { font-size: var(--px-24); line-height: 1; }
  .nav-links {
    margin-inline-start: auto;
    display: flex;
    gap: var(--space-xl);
  }
  .nav-link {
    position: relative;
    color: var(--color-ink-2);
    font-size: var(--px-12);
    line-height: 1.6;
    padding-block: var(--space-2xs);
    text-decoration: none;
    transition: color var(--dur-micro) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover { color: var(--color-ink); }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: var(--border-pixel);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-short) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover::after { transform: scaleX(1); }
  }
  .nav-link[aria-current='page'] { color: var(--color-accent-text); }
  .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .nav-actions { display: flex; align-items: center; gap: var(--space-sm); flex-shrink: 0; }

  @media (max-width: 40rem) {
    .nav-inner { flex-wrap: wrap; padding-block: var(--space-xs); row-gap: var(--space-2xs); }
    .nav-links { margin-inline-start: 0; order: 3; width: 100%; gap: var(--space-lg); }
    .nav-actions { margin-inline-start: auto; }
  }
</style>
