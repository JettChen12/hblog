---
/**
 * 像素星徽（静态）：hero 右侧的站点纹章，一条完整的视觉故事线——
 * 轨道从带环行星的顶缘升起，火箭沿轨道切线爬升（尾焰落在轨道线上），
 * 终点是带太阳能板的卫星。行星分层明暗：贴边高光新月/条带/宽幅抖动明暗界线/下缘暖色反光。
 * 程序化生成，配色走 token，明暗主题自动适配。
 */
type Ch = '.' | 'B' | 'H' | 'S' | 'R' | 'A' | 'M' | 'W' | 'P';
const FILL: Record<Exclude<Ch, '.'>, string> = {
  B: 'var(--color-ink-2)', // 行星主体
  H: 'var(--color-emblem-light)', // 高光新月 / 卫星亮面（跨主题恒亮）
  S: 'var(--color-emblem-dark)', // 暗面 / 细节（跨主题恒暗）
  R: 'var(--color-rule-strong)', // 条带 / 轨道 / 尾迹 / 板面
  A: 'var(--color-accent)', // 火箭鼻锥 / 火焰 / 星尘
  M: 'var(--color-emblem-amber)', // 行星环 / 舷窗 / 暖色反光（浅底加深的琥珀）
  W: 'var(--color-emblem-light)', // 火箭机身（跨主题恒亮）
  P: 'var(--color-ink-3)', // 卫星
};

const W = 32;
const H = 40;
const g: Ch[][] = Array.from({ length: H }, () => Array<Ch>(W).fill('.'));
const put = (x: number, y: number, c: Ch) => {
  const cx = Math.round(x);
  const cy = Math.round(y);
  if (cx >= 0 && cx < W && cy >= 0 && cy < H) g[cy][cx] = c;
};

// —— 行星环（后半，先画；行星随后盖住中段）——
for (let x = 1; x <= 22; x++) put(x, 26, 'M');

// —— 行星：圆 r=7，圆心 (10, 28)，沉在左下 ——
const CX = 10;
const CY = 28;
const R = 7;
for (let dy = -R; dy <= R; dy++) {
  const half = Math.round(Math.sqrt(R * R - dy * dy));
  for (let dx = -half; dx <= half; dx++) {
    const px = CX + dx;
    const py = CY + dy;
    const d = Math.hypot(dx, dy);
    let c: Ch = 'B';
    if (dy === -3 || dy === -2 || dy === 2) c = 'R'; // 条带
    const s = dx + dy; // 光照方向：左上亮、右下暗
    if (s >= 9) c = 'S'; // 暗面
    else if (s >= 5 && (px + py) % 2 === 0) c = 'S'; // 宽幅抖动明暗界线
    if (d >= R - 1.5 && s <= -4) c = 'H'; // 贴边高光新月
    if (d >= R - 1.5 && s >= 3 && (px + py) % 2 === 1) c = 'M'; // 下缘暖色环境反光
    put(px, py, c);
  }
}
// 环的前半（压在行星下缘），两端加斜向衔接像素连回后环
for (let x = 3; x <= 17; x++) put(x, 29, 'M');
put(1, 27, 'M'); put(2, 28, 'M');
put(18, 28, 'M'); put(19, 27, 'M');

// —— 轨道弧：二次贝塞尔，从行星顶缘升起、扫向右上卫星 ——
const p0 = [13, 20];
const pc = [13, 3];
const p1 = [26, 6];
const seen = new Set<string>();
for (let i = 0; i <= 16; i++) {
  const t = i / 16;
  const u = 1 - t;
  const x = Math.round(u * u * p0[0] + 2 * t * u * pc[0] + t * t * p1[0]);
  const y = Math.round(u * u * p0[1] + 2 * t * u * pc[1] + t * t * p1[1]);
  const key = `${x},${y}`;
  if (seen.has(key)) continue;
  seen.add(key);
  if (g[y]?.[x] === '.') put(x, y, 'R');
}

// —— 卫星：r=3 球体（亮面 + 双环形山）+ 两侧太阳能板，坐在轨道终点 ——
const MX = 26;
const MY = 6;
for (let dy = -3; dy <= 3; dy++) {
  const half = Math.round(Math.sqrt(9 - dy * dy));
  for (let dx = -half; dx <= half; dx++) put(MX + dx, MY + dy, 'P');
}
put(MX - 2, MY - 2, 'H'); // 亮面
put(MX - 1, MY - 2, 'H');
put(MX, MY + 1, 'S'); // 环形山（单 crater，小尺寸下细节做减法）
put(22, 5, 'R'); put(22, 6, 'S'); put(22, 7, 'R'); // 左太阳能板（1px 宽，带棚线）
put(30, 5, 'R'); put(30, 6, 'S'); put(30, 7, 'R'); // 右太阳能板

// —— 火箭：沿轨道切线爬升（向上每 3 行右移 1 列的微倾剪影）——
put(17, 5, 'A'); // 鼻锥
for (let x = 16; x <= 18; x++) put(x, 6, 'A');
for (let x = 15; x <= 17; x++) { put(x, 7, 'W'); put(x, 8, 'W'); put(x, 9, 'W'); }
put(16, 8, 'M'); // 舷窗
for (let x = 14; x <= 16; x++) { put(x, 10, 'W'); put(x, 11, 'W'); put(x, 12, 'W'); }
put(15, 11, 'M'); // 舷窗
for (let x = 13; x <= 15; x++) put(x, 13, 'W'); // 基座
put(12, 12, 'S'); put(12, 13, 'S'); // 左尾翼
put(17, 12, 'S'); put(17, 13, 'S'); // 右尾翼
put(13, 14, 'A'); put(12, 15, 'A'); put(11, 16, 'A'); // 火焰（沿切线反向）
put(10, 18, 'R'); put(9, 20, 'R'); // 点状尾迹

// —— 星尘（收敛到三粒，其余交给全站星空）——
put(4, 10, 'A'); put(5, 10, 'A');
put(8, 2, 'M');
put(29, 33, 'A');
put(25, 37, 'M');

// 序列化：同行同色合并
let rects = '';
for (let y = 0; y < H; y++) {
  let x = 0;
  while (x < W) {
    const c = g[y][x];
    if (c === '.') { x++; continue; }
    let run = 1;
    while (x + run < W && g[y][x + run] === c) run++;
    rects += `<rect x="${x}" y="${y}" width="${run}" height="1" fill="${FILL[c]}"/>`;
    x += run;
  }
}
---
<div class="emblem" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges">
    <Fragment set:html={rects} />
  </svg>
</div>

<style>
  .emblem { width: min(232px, 46vw); line-height: 0; }
  .emblem svg { width: 100%; height: auto; display: block; }
</style>
