---
/**
 * 像素太阳系（静态）：hero 右侧的站点纹章——
 * 太阳贴在右缘，涟漪状同心轨道环向左层层扩大（内圈实线、外圈棋盘虚线渐淡），
 * 几枚小像素行星落在各自的轨道上。程序化生成（中点画圆），配色走 token，
 * 明暗主题自动适配，受光方向全站统一朝左上。
 */
type Ch = '.' | 'R' | 'L' | 'B' | 'P' | 'A' | 'M' | 'H' | 'S';
const FILL: Record<Exclude<Ch, '.'>, string> = {
  R: 'var(--color-rule-strong)', // 内圈实线轨道
  L: 'var(--color-rule)', // 外圈虚线轨道（渐淡）
  B: 'var(--color-ink-2)', // 行星主体
  P: 'var(--color-ink-3)', // 远行星
  A: 'var(--color-accent)', // 太阳边缘 / 远轨珊瑚小行星
  M: 'var(--color-emblem-amber)', // 太阳核心 / 琥珀气态行星
  H: 'var(--color-emblem-light)', // 高光 / 冰行星白芯
  S: 'var(--color-emblem-dark)', // 行星暗面 / 冰行星描边
};

const W = 44;
const H = 40;
const g: Ch[][] = Array.from({ length: H }, () => Array<Ch>(W).fill('.'));
const put = (x: number, y: number, c: Ch) => {
  const cx = Math.round(x);
  const cy = Math.round(y);
  if (cx >= 0 && cx < W && cy >= 0 && cy < H) g[cy][cx] = c;
};

const CX = 40; // 太阳（涟漪圆心）贴近右缘，环向左扩大
const CY = 20;

// —— 涟漪轨道环：中点画圆；内实外虚，颜色向外降档渐淡 ——
const RINGS: { r: number; c: Ch; dotted: boolean }[] = [
  { r: 6, c: 'R', dotted: false },
  { r: 11, c: 'R', dotted: false },
  { r: 16, c: 'R', dotted: true },
  { r: 21, c: 'L', dotted: true },
  { r: 26, c: 'L', dotted: true },
];
for (const { r, c, dotted } of RINGS) {
  let x = r;
  let y = 0;
  let err = 0;
  while (x >= y) {
    const oct = [
      [CX + x, CY + y], [CX + y, CY + x], [CX - y, CY + x], [CX - x, CY + y],
      [CX - x, CY - y], [CX - y, CY - x], [CX + y, CY - x], [CX + x, CY - y],
    ];
    for (const [px, py] of oct) {
      if (dotted && (px + py) % 2 !== 0) continue;
      put(px, py, c);
    }
    y++;
    err += 1 + 2 * y;
    if (2 * (err - x) + 1 > 0) {
      x--;
      err += 1 - 2 * x;
    }
  }
}

// —— 太阳：琥珀核心 + 珊瑚边缘 + 左上一粒高光（自发光体，不做暗面）——
for (let dy = -3; dy <= 3; dy++) {
  for (let dx = -3; dx <= 3; dx++) {
    const d = Math.hypot(dx, dy);
    if (d <= 3) put(CX + dx, CY + dy, d > 2.3 ? 'A' : 'M');
  }
}
put(CX - 1, CY - 1, 'H');

// —— 行星：落在各自轨道上，高光统一朝左上 ——
const disc = (cx: number, cy: number, r: number, c: Ch) => {
  for (let dy = -r; dy <= r; dy++) {
    for (let dx = -r; dx <= r; dx++) {
      if (dx * dx + dy * dy <= r * r + 0.5) put(cx + dx, cy + dy, c);
    }
  }
};
disc(31, 14, 2, 'M'); put(30, 13, 'H'); put(32, 15, 'S'); // 近轨琥珀气态行星（白高光+暗面）
for (let dy = -1; dy <= 1; dy++) {
  for (let dx = -1; dx <= 1; dx++) put(21 + dx, 29 + dy, dx === 0 && dy === 0 ? 'H' : 'S'); // 中轨冰行星：白芯+深描边，浅底不融背景
}
disc(15, 13, 1, 'A'); // 远轨珊瑚小行星

// 序列化：同行同色合并
let rects = '';
for (let y = 0; y < H; y++) {
  let x = 0;
  while (x < W) {
    const c = g[y][x];
    if (c === '.') { x++; continue; }
    let run = 1;
    while (x + run < W && g[y][x + run] === c) run++;
    rects += `<rect x="${x}" y="${y}" width="${run}" height="1" fill="${FILL[c]}"/>`;
    x += run;
  }
}
---
<div class="emblem" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} shape-rendering="crispEdges">
    <Fragment set:html={rects} />
  </svg>
</div>

<style>
  .emblem { width: min(256px, 48vw); line-height: 0; }
  .emblem svg { width: 100%; height: auto; display: block; }
</style>
